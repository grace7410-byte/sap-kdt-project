// ============================================================
managed implementation in class zbp_r_b07_lfa1 unique;
strict ( 2 );
with draft;

define behavior for ZR_B07_LFA1 //alias <alias_name>
persistent table ztb07lfa1
draft table ztb07lfa1_d
lock master
total etag ChangedAt
authorization master ( instance )
etag master LocChangedAt
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) LifUuid;
  field ( mandatory : create ) Fdgrv;
  field ( readonly : update ) Waers;
  field ( readonly ) Lifnr, Glact;
  field ( features : instance ) Loevm; // 거래종료에 대한 피드백 반영 사항

  determination SetInitialDefault on modify { create; }
  determination SetVendorNumber on save { create; }

  validation CheckInit on save { create; update; }
  // 추가(조정계정이 찐인지 확인)
  validation checkAkont on save { create; update; }

  draft action Edit;
  draft action Activate;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare{
    validation CheckInit;
    validation checkAkont;
  }

  mapping for ztb07lfa1 corresponding
    {

      //      Akont        = akont;
      //      Ekgrp        = ekgrp;
      //      Ekorg        = ekorg;
      //      Fdgrv        = fdgrv;
      //      Lifnr        = lifnr;
      //      Loevm        = loevm;
      //      Minbw        = minbw;
      //      Name1        = name1;
      //      Waers        = waers;
      ChangedAt    = changed_at;
      ChangedBy    = changed_by;
      CreatedBy    = created_by;
      CreationAt   = creation_at;
      LifUuid      = lif_uuid;
      LocChangedAt = loc_changed_at;
    }
}
