managed implementation in class zbp_r_b07_eina unique;
strict ( 2 );
with draft;

define behavior for zr_b07_eina //alias <alias_name>
persistent table ztb07eina
draft table ztb07eina_d
lock master
total etag ChangedAt
authorization master ( instance )
etag master LocChangedAt
{
  field ( numbering : managed, readonly ) InfUuid;
  field ( readonly : update ) Infnr;

  create;
  update;
  delete;

  determination SetDefaults on modify { create; }
  determination SetInfnrNumber on save { create; }

  validation CheckRequired on save { create; update; }
  validation CheckDuplicate on save { create; update; field LifUuid, MatUuid; }
  validation CheckEsokz on save { create; update; field Esokz; }

  draft action Edit;
  draft action Activate;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare { }

  association _Eine { create; with draft; }

  mapping for ztb07eina corresponding
    {
      ChangedAt    = changed_at;
      ChangedBy    = changed_by;
      CreatedBy    = created_by;
      CreationAt   = creation_at;
      //    Ekgrp = ekgrp;
      //    Ekorg =
      //    esokz =
      InfUuid      = inf_uuid;
      //    Infnr = infnr;
      Irtxt        = txz01;
      LifUuid      = lif_uuid;
      LocChangedAt = loc_changed_at;
      //    Loekz
      //    Meins =
    }
}

define behavior for zi_b07_eine alias Eine
persistent table ztb07eine
draft table ztb07eine_d
lock dependent by _Eina
authorization dependent by _Eina
etag dependent by _Eina
{
  update;
  delete;

  field ( readonly ) InfUuid;
  field ( mandatory : create, readonly : update ) Werks;
  field ( features : instance ) Waers;
  // field ( readonly ) Waers; // Stprs(표준가격)와 동일한 이유로 에러남(정적 제어) — 아래 참고

  determination SetItemDefaults on modify { create; }

  validation CheckExist on save { create; update; field Werks; }
  validation CheckPositive on save { create; update; field Peinh; }

  association _Eina { with draft; }

  mapping for ztb07eine corresponding
    {
      //    Aplfz=
      //    Bprme =
      //    Bstma =
      ChangedAt  = changed_at;
      ChangedBy  = changed_by;
      CreatedBy  = created_by;
      CreationAt = creation_at;
      InfUuid    = inf_uuid;
      //    Loekz
      //    Netpr= 7
      //    Peinh = = 7
